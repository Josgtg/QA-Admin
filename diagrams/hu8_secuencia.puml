@startuml
skinparam shadowing false
skinparam responseMessageBelowArrow true

actor "Encargado de QA" as Encargado

box "Template Layer"
participant "MetricasProyectoTemplate" as Lista
participant "HistorialMetricaTemplate" as Detalle
end box

box "View Layer (reportes.view)"
participant "MetricasProyectoView" as VistaLista
participant "HistorialMetricaView" as VistaDetalle
end box

box "Model Layer"
participant "p: Proyecto" as Proyecto
participant "m: Metrica" as Metrica
end box

== Estado de las metricas del proyecto (HU-08) ==

Encargado -> Lista: Abre las metricas del proyecto
Lista -> VistaLista: get(req, proyecto_id)
activate VistaLista

VistaLista -> Proyecto: metricas_seleccionadas()
activate Proyecto
Proyecto --> VistaLista: List<Metrica>
deactivate Proyecto

alt no hay metricas seleccionadas
    VistaLista --> Lista: HttpResponse (200 OK, estado vacio)
else hay metricas
    loop por cada metrica m
        VistaLista -> Metrica: ultima_revision(p)
        activate Metrica
        Metrica --> VistaLista: r o null
        deactivate Metrica

        VistaLista -> Metrica: estado_de(r)
        activate Metrica
        Metrica --> VistaLista: EstadoMetrica
        deactivate Metrica
    end

    VistaLista --> Lista: HttpResponse (200 OK)
end
deactivate VistaLista

Lista --> Encargado: Ultimo valor, meta y estado; NO_CUMPLE resaltado

== Historial de una metrica (HU-08) ==

Encargado -> Lista: Elige una metrica
Lista -> VistaDetalle: get(req, proyecto_id, metrica_id)
activate VistaDetalle

VistaDetalle -> Proyecto: metricas_seleccionadas()
activate Proyecto
Proyecto --> VistaDetalle: List<Metrica>
deactivate Proyecto

alt la metrica no esta entre las seleccionadas
    VistaDetalle --> Detalle: HttpResponse (404)
else metrica valida
    VistaDetalle -> Metrica: historial_en(p)
    activate Metrica
    Metrica --> VistaDetalle: List<RevisionMetrica>
    deactivate Metrica

    VistaDetalle --> Detalle: HttpResponse (200 OK)
end
deactivate VistaDetalle

Detalle --> Encargado: Historial con fecha, valor y evidencia o aviso de historial vacio

@enduml
