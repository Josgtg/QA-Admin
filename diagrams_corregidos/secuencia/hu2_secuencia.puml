@startuml
skinparam shadowing false
skinparam responseMessageBelowArrow true

actor "Encargado de QA" as Encargado

box "Template Layer"
  participant "SeleccionModeloTemplate" as UI
end box

box "View Layer (modelos.view)"
  participant "AplicarModeloView" as View
end box

box "Model Layer"
  participant "ModeloCalidad" as Modelo
  participant "p: Proyecto" as Proyecto
  participant "ma_vigente: ModeloAplicado" as AplicacionVigente
  participant "ma_nueva: ModeloAplicado" as NuevaAplicacion
  participant "MetricaAplicada" as Instantanea
end box

== Seleccionar y aplicar modelo de calidad (HU-02) ==

Encargado -> UI: abrir(proyectoId)
UI -> View: get(request, proyectoId)
activate View

View -> Modelo: obtener_predefinidos()
activate Modelo
Modelo --> View: modelos: List<ModeloCalidad> (con características y métricas)
deactivate Modelo

View --> UI: HttpResponse (200, modelos)
deactivate View
UI --> Encargado: Muestra modelos, descripciones y características

Encargado -> UI: seleccionar(modelo_id, confirmacion)
note right of UI
  request.POST contiene modelo_id y confirmacion.
  modelo es el ModeloCalidad predefinido seleccionado.
end note
UI -> View: post(request, proyecto_id)
activate View

View -> Proyecto: modelo_aplicado_vigente()
activate Proyecto
Proyecto --> View: anterior: ModeloAplicado o null
deactivate Proyecto

View -> Proyecto: tiene_mediciones()
activate Proyecto
Proyecto --> View: hay_mediciones: boolean
deactivate Proyecto

alt Mismo modelo ya vigente
    View --> UI: HttpResponse (200, anterior; sin cambios)
    UI --> Encargado: Modelo, características y métricas
else Modelo diferente vigente, con mediciones y sin confirmación
    View --> UI: HttpResponse (200, requiere_confirmacion=true)
    UI --> Encargado: Confirma o cancela
    note right of UI
      Confirmar inicia otro POST con confirmacion=true.
      Esta petición termina sin guardar cambios.
    end note
else Primera aplicación, cambio sin mediciones o cambio confirmado
    View -> Proyecto: aplicar_modelo(modelo)
    activate Proyecto
    opt Existe aplicación anterior
        Proyecto -> AplicacionVigente: cerrar()
        AplicacionVigente --> Proyecto: void (anterior conservada, vigente=false)
    end
    create participant "nueva: ModeloAplicado" as Nueva
    Proyecto -> Nueva: ModeloAplicado(proyecto, modelo)
    activate Nueva
    Nueva -> Instantanea: crear_instantanea()
    activate Instantanea
    Instantanea --> Nueva: metricas_aplicadas: List<MetricaAplicada>
    deactivate Instantanea
    Nueva --> Proyecto: nueva: ModeloAplicado (vigente=true)
    deactivate Nueva
    Proyecto --> View: nueva: ModeloAplicado
    deactivate Proyecto
    View --> UI: HttpResponse (302, URL del detalle del proyecto)
    UI --> Encargado: Muestra modelo, características y métricas
end

deactivate View

opt Se solicitó confirmación y el encargado cancela
    Encargado -> UI: cancelar()
    UI --> Encargado: Conserva el modelo actual, sin guardar cambios
end

@enduml
