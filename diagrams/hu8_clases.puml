@startuml clases_hu08
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype polyline
skinparam packageStyle rectangle
skinparam nodesep 60
skinparam ranksep 80
skinparam defaultFontSize 12
skinparam classFontSize 12

title Clases: estado de las metricas del proyecto (HU-08)

package "reportes.template" #E1F5EE {
  class MetricasProyectoTemplate
  class HistorialMetricaTemplate
}

package "reportes.view" #FAEEDA {
  class MetricasProyectoView {
    + get(request: HttpRequest, proyecto_id: int): HttpResponse
  }

  class HistorialMetricaView <<propuesta>> {
    + get(request: HttpRequest, proyecto_id: int, metrica_id: int): HttpResponse
  }
}

package "tecnicas.model" #E1F5EE {
  class Proyecto {
    - id: int
    - nombre: String
    + metricas_seleccionadas(): List<Metrica>
  }
}

package "modelos.model" #EEEDFE {
  enum TipoUmbral {
    MINIMO
    MAXIMO
  }

  enum EstadoMetrica {
    CUMPLE
    NO_CUMPLE
    SIN_MEDICION
  }

  class Caracteristica {
    - id: int
    - nombre: String
  }

  class Metrica {
    - id: int
    - nombre: String
    - unidad: String
    - meta: Float [0..1]
    - tipo_umbral: TipoUmbral
    - activa: boolean
    + ultima_revision(proyecto: Proyecto): RevisionMetrica [0..1]
    + estado_de(ultima: RevisionMetrica [0..1]): EstadoMetrica
    + historial_en(proyecto: Proyecto): List<RevisionMetrica>
  }

  class RevisionMetrica <<propuesta HU-01>> {
    - id: int
    - valor: Float
    - fecha: Date
    - enlace: String [0..1]
    - archivo: String [0..1]
    - cumple: boolean
  }
}

' Relaciones de dominio
Caracteristica "1" *- "0..*" Metrica
Metrica "1" -- "0..*" RevisionMetrica : se mide en
Proyecto "1" -. "0..*" RevisionMetrica : registra

Metrica --> TipoUmbral
Metrica --> EstadoMetrica

' Relaciones MVT
MetricasProyectoTemplate ..> MetricasProyectoView : dispara solicitud >
HistorialMetricaTemplate ..> HistorialMetricaView : dispara solicitud >
MetricasProyectoView ...> Proyecto : consulta metricas >
MetricasProyectoView ..> Metrica : consulta estado >
HistorialMetricaView ...> Proyecto : valida acceso >
HistorialMetricaView ..> Metrica : consulta historial >

' Notas de los CA
note bottom of Proyecto
  CA1 · metricas_seleccionadas() devuelve
  las metricas activas del modelo aplicado
  (HU-02). Sin modelo aplicado la lista
  queda vacia y la vista muestra el
  estado vacio.
end note

note top of Metrica
  CA1 · ultima_revision() elige la
  revision mas reciente por fecha; en
  empate, la de mayor id.
  CA2 · estado_de(None) devuelve
  SIN_MEDICION, que nunca cuenta
  como cumplida.
  CA4 · estado_de(r) devuelve
  NO_CUMPLE cuando r.cumple = false.
end note

note bottom of RevisionMetrica
  HU-01 registra la revision con valor,
  fecha y evidencia (enlace o archivo),
  y con el autor MiembroProyecto del
  proyecto. HU-08 solo la lee: no crea
  ni modifica. cumple se calcula al
  registrar con Metrica.cumple_meta(valor)
  y se conserva para que el historial no
  cambie si la meta se edita despues.
end note

note as A1
  CA1 · Muestra el ultimo
  valor, la meta y el estado
  de cada metrica. CA3
  · Cada fila enlaza a su
  historial. CA4 · La plantilla
  aplica la clase border-red a
  las filas NO_CUMPLE.
end note

A1 .. MetricasProyectoView

note as A2
  CA3 · Valida que la metrica pertenezca a
  metricas_seleccionadas(); si no, responde
  404. Muestra fecha, valor y evidencia de
  cada revision, de la mas reciente a la
  mas antigua, o el aviso de historial
  vacio.
end note

HistorialMetricaView . A2

@enduml
