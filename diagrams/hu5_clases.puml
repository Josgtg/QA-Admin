@startuml clases_tecnicas_qa
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam nodesep 50
skinparam ranksep 60

title Clases: catalogo y seguimiento de tecnicas QA (HU-04 y HU-05)

package "tecnicas.template" #E1F5EE {
  class SeleccionTecnicaTemplate {
  }
}

package "tecnicas.view" #E1F5EE {
  class SeguirTecnicaView {
    + seguir_tecnica(proyecto: Proyecto, tecnica: TecnicaQA)
    + remover_tecnica(seguimiento: SeguimientoTecnica)
  }
}

package "tecnicas.model" #E1F5EE {
  enum Dimension {
    ESPECIFICACION
    DISENO
    DESARROLLO
    CONFORMIDAD
  }

  enum TipoControl {
    VERIFICACION
    VALIDACION
  }

  class TecnicaQA {
    - id: int
    - nombre: String
    - descripcion: String
    - objetivo: String
    - pregunta_clave: String
    - dimension: Dimension
    - tipo_control: TipoControl
    + obtener_pasos(): List<Paso>
  }

  class Paso {
    - id: int
    - orden: int
    - instruccion: String
    - evidencia_esperada: String
  }

  class SeguimientoTecnica {
    - id: int
    - activa: boolean
    + tiene_evidencias_registradas(): boolean
    + calcular_avance(): Float
    + desactivar(): void
  }

  class SeguimientoPaso {
    - id: int
    - completado: boolean
    - comentario: String
    - fecha_completado: Date
    + agregar_evidencia(e: Evidencia): void
    + marcar_completado(): void
  }

  class Evidencia {
    - id: int
    - enlace: String
    - archivo: String
    - fecha_registro: Date
  }
}

package "reportes.model" #FAEEDA {
  class Proyecto {
    - id: int
    - nombre: String
    - fecha_inicio: Date
    - fecha_fin: Date
  }

  class MiembroProyecto {
    - id: int
    - rol: String
    - activo: boolean
  }
}

TecnicaQA "1" *-- "1..*" Paso
TecnicaQA --> Dimension
TecnicaQA --> TipoControl

SeguimientoTecnica "*" --> "1" Proyecto
SeguimientoTecnica "*" --> "1" TecnicaQA
SeguimientoTecnica "1" *-- "1..*" SeguimientoPaso
SeguimientoPaso "*" --> "1" Paso
SeguimientoPaso "1" *-- "0..1" Evidencia
Evidencia "*" --> "1" MiembroProyecto : autor

Proyecto "1" *-- "0..*" MiembroProyecto

SeleccionTecnicaTemplate ..> SeguirTecnicaView : dispara solicitud >
SeguirTecnicaView ..> SeguimientoTecnica : crea / desactiva >

note right of SeguimientoTecnica
  Es la app tecnicas quien conoce a Proyecto,
  nunca al reves. Quitar una tecnica la
  desactiva (activa = False) y conserva
  sus evidencias.
end note

note bottom of Evidencia
  Regla: el autor debe ser MiembroProyecto
  del mismo Proyecto (se valida en clean()).
end note
@enduml
