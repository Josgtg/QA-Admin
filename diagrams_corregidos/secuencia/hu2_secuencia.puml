@startuml
skinparam shadowing false
skinparam responseMessageBelowArrow true

actor "Encargado de QA" as Encargado

box "Template Layer"
  participant "SeleccionModeloTemplate" as UI
end box

box "View Layer (modelos.view)"
  participant "AplicarModeloView" as View
end box

box "Model Layer"
  participant "ModeloCalidad" as Modelo
  participant "p: Proyecto" as Proyecto
  participant "ma_vigente: ModeloAplicado" as AplicacionVigente
end box

== Seleccionar y aplicar modelo de calidad (HU-02) ==

Encargado -> UI: abrir(proyecto_id)
UI -> View: get(request, proyecto_id)
activate View

View -> Modelo: obtener_predefinidos()
activate Modelo
Modelo --> View: modelos: List<ModeloCalidad> (con características y métricas)
deactivate Modelo

View --> UI: HttpResponse (200, modelos)
deactivate View
UI --> Encargado: Muestra modelos, descripciones y características

Encargado -> UI: seleccionar(modelo_id, confirmacion, contexto_confirmacion)
note right of UI
  request.POST contiene modelo_id, confirmacion
  y el contexto firmado recibido en el aviso.
  modelo es el ModeloCalidad predefinido seleccionado.
end note
UI -> View: post(request, proyecto_id)
activate View

View -> Proyecto: modelo_aplicado_vigente()
activate Proyecto
Proyecto --> View: anterior: ModeloAplicado o null
deactivate Proyecto

alt Mismo modelo ya vigente
    View --> UI: HttpResponse (200, anterior; sin cambios)
    UI --> Encargado: Modelo, características y métricas
else Aplicar o cambiar el modelo
    View -> Proyecto: aplicar_modelo(modelo, verificar_confirmacion=true, contexto_confirmacion)
    activate Proyecto
    note right of Proyecto
      Comienza la transacción.
      Un UPDATE del propio valor reserva la escritura
      antes de leer el estado vigente, también en SQLite.
    end note
    Proyecto -> Proyecto: modelo_aplicado_vigente()
    Proyecto --> Proyecto: anterior: ModeloAplicado o null
    alt Otra solicitud ya aplicó el mismo modelo
        Proyecto --> View: vigente: ModeloAplicado (sin duplicar)
        View --> UI: HttpResponse (302, URL del detalle del proyecto)
    else El modelo es diferente
    Proyecto -> Proyecto: tiene_mediciones()
    Proyecto --> Proyecto: hay_mediciones: boolean

    opt Contexto presente o cambio de modelo con mediciones
        Proyecto -> Proyecto: validar_confirmacion_modelo(modelo, anterior, contexto_confirmacion)
        note right of Proyecto
          Comprueba firma, antigüedad máxima de 30 minutos
          y coincidencia de proyecto, destino y aplicación.
        end note
        Proyecto --> Proyecto: void o ValidationError(contexto_nuevo)
    end

    alt Falta confirmar, contexto alterado, vencido o estado distinto
        Proyecto --> View: ValidationError (requiere_confirmacion, contexto_nuevo)
        note right of Proyecto
          Rollback y fin de la transacción.
          Se conservan aplicación e historial.
        end note
        View --> UI: HttpResponse (200, aviso y contexto_nuevo)
        UI --> Encargado: Revisa el modelo vigente y confirma o cancela
        note right of UI
          Confirmar inicia otro POST independiente con
          confirmacion=1 y contexto_confirmacion.
        end note
    else Modelo válido y confirmación válida cuando es necesaria
        opt Existe aplicación anterior y el modelo es diferente
            Proyecto -> AplicacionVigente: cerrar()
            AplicacionVigente --> Proyecto: void (vigente=false)
        end
        create participant "nueva: ModeloAplicado" as Nueva
        Proyecto -> Nueva: ModeloAplicado(proyecto, modelo)
        Nueva --> Proyecto: nueva: ModeloAplicado (vigente=true)
        Proyecto -> Nueva: crear_instantanea()
        Nueva --> Proyecto: metricas_aplicadas: List<MetricaAplicada>
        note right of Proyecto
          Commit al completar la operación.
          Un fallo de escritura revierte cierre,
          aplicación e instantáneas.
        end note
        Proyecto --> View: nueva o vigente: ModeloAplicado
        View --> UI: HttpResponse (302, URL del detalle del proyecto)
        UI --> Encargado: Muestra modelo, características y métricas
    end
    end
    deactivate Proyecto
end

deactivate View

opt Se solicitó confirmación y el encargado cancela
    Encargado -> UI: cancelar()
    UI --> Encargado: Conserva el modelo actual, sin guardar cambios
end

@enduml
