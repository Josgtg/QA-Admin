@startuml
skinparam shadowing false
skinparam responseMessageBelowArrow true

actor "Encargado de QA" as Encargado

box "Template Layer"
participant "ListaProyectosTemplate" as UI
end box

box "View Layer (reportes.view)"
participant "ListaProyectosView" as View
end box

box "Model Layer (reportes.model)"
participant "Periodo" as Periodos
participant "p: Periodo" as Periodo
end box

== Proyectos por periodo (HU-07) ==

Encargado -> UI: Abre la lista de proyectos y elige un periodo (opcional)
UI -> View: get(req: HttpRequest)
activate View

alt "se eligió un periodo"
    View -> Periodo: obtenerProyectos()
    activate Periodo
    Periodo --> View: List<Proyecto>
    deactivate Periodo
else "sin filtro"
    View -> Periodos: obtenerRecientes()
    activate Periodos
    Periodos --> View: List<Periodo>
    deactivate Periodos

    loop "por cada Periodo, del más reciente al más antiguo"
        View -> Periodo: obtenerProyectos()
        activate Periodo
        Periodo --> View: List<Proyecto>
        deactivate Periodo
    end
end

View --> UI: HttpResponse (200 OK)
deactivate View

UI --> Encargado: Muestra los proyectos o «No hay proyectos en este periodo»

@enduml
