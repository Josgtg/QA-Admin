@startuml hu1_secuencia
skinparam shadowing false
skinparam responseMessageBelowArrow true

actor "Encargado de QA" as Encargado

box "Template Layer"
  participant "RevisionMetricaTemplate" as Template
end box

box "View Layer (modelos.view)"
  participant "RegistrarRevisionMetricaView" as View
  participant "DescargarEvidenciaMetricaView" as Descarga
end box

box "Form Layer (modelos.forms)"
  participant "RevisionMetricaForm" as Form
end box

box "Model Layer (reportes.model / modelos.model)"
  participant "m: Metrica" as Metrica
  participant "r: RevisionMetrica" as Revision
end box

== Consultar formulario e historial (HU-01) ==

Encargado -> Template: abrir(proyecto_id, metrica_id)
Template -> View: get(request, proyecto_id, metrica_id)
activate View

View -> View: obtener_metrica_aplicada(proyecto, metrica_id)
View --> View: instantanea: MetricaAplicada o null
alt Sin aplicación vigente o métrica ajena al modelo
    View --> Template: HttpResponse (302, selección del modelo)
else Métrica disponible
    View -> View: obtener_historial(proyecto, metrica)
    View --> View: historial: List<RevisionMetrica>
    View -> Metrica: ultima_revision(proyecto)
    Metrica --> View: ultima: RevisionMetrica o null
    View -> Metrica: ultimo_valor(proyecto)
    Metrica --> View: valor_ultimo: Float o null
    View --> Template: HttpResponse (200, formulario, instantánea e historial)
    Template --> Encargado: Muestra rango, meta, estado, autor y evidencias
end
deactivate View

== Registrar medición con evidencia ==

Encargado -> Template: enviar(valor, fecha, enlace, archivo, miembro_proyecto_id)
Template -> View: post(request, proyecto_id, metrica_id)
activate View

View -> View: obtener_metrica_aplicada(proyecto, metrica_id)
View --> View: instantanea: MetricaAplicada o null
alt Sin aplicación vigente o métrica ajena al modelo
    View --> Template: HttpResponse (302, selección del modelo)
else Métrica disponible
    View -> Form: RevisionMetricaForm(request.POST, request.FILES, proyecto)
    View -> Form: is_valid()
    Form --> View: formulario_valido: boolean
    alt Campos inválidos, autor ajeno o falta evidencia
        View --> Template: HttpResponse (200, formulario con errores)
        Template --> Encargado: Señala los campos que debe corregir
    else Formulario válido
        View -> Form: save(commit=false)
        Form --> View: revision: RevisionMetrica sin guardar
        note right of View
          Se asigna revision.metrica_aplicada = instantanea.
        end note
        View -> Revision: full_clean()
        Revision -> Revision: clean()
        Revision -> Revision: tiene_evidencia()
        Revision --> Revision: hay_evidencia: boolean
        Revision -> Metrica: validar_rango(valor)
        Metrica --> Revision: rango_ok: boolean
        note right of Revision
          clean() verifica también que el autor
          pertenezca al proyecto de la instantánea.
        end note
        Revision --> View: void o ValidationError
        alt Error de rango o pertenencia
            View --> Template: HttpResponse (200, formulario con errores)
            Template --> Encargado: Muestra el error sin guardar la revisión
        else Revisión válida
            View -> Revision: save()
            Revision -> Revision: calcular_cumple()
            Revision --> Revision: cumple: boolean según la instantánea
            Revision --> View: void (valor, fecha, evidencia, autor y cumple guardados)
            View --> Template: HttpResponse (302, métricas del proyecto)
            Template --> Encargado: Historial y cumplimiento actualizados al consultar métricas
        end
    end
end
deactivate View

opt El encargado cancela
    Encargado -> Template: cancelar()
    Template --> Encargado: Vuelve a métricas sin enviar POST
end

== Descargar un archivo del historial ==

Encargado -> Template: descargar_archivo(proyecto_id, revision_id)
Template -> Descarga: get(request, proyecto_id, revision_id)
activate Descarga
note right of Descarga
  Consulta RevisionMetrica por revisión y proyecto.
  Incluye aplicaciones históricas del modelo.
  Abre el archivo usando su almacenamiento.
end note
alt Revisión ajena, inexistente o archivo ausente
    Descarga --> Template: HttpResponse (404)
else Archivo disponible
    Descarga --> Template: FileResponse (200, archivo adjunto)
    Template --> Encargado: Archivo de evidencia descargado
end
deactivate Descarga

@enduml
