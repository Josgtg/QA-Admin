@startuml hu10_clases
skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 45
skinparam ranksep 55
skinparam packageStyle rectangle

title Clases: registro de evidencias de un paso de una TQA (HU-10)

package "tecnicas" #E1F5EE {
  package "template" {
    class RegistroEvidenciaTemplate {
    }
  }

  package "view" {
    class RegistrarEvidenciaView {
      + get(req: HttpRequest, seguimiento_paso_id: int): HttpResponse
      + post(req: HttpRequest, seguimiento_paso_id: int): HttpResponse
      + obtener_paso(seguimiento_paso_id: int): SeguimientoPaso
      + renderizar(req: HttpRequest, formulario: EvidenciaForm): HttpResponse
    }

    class AbrirEvidenciaView {
      + get(req: HttpRequest, evidencia_id: int): HttpResponse
      + obtener_evidencia(evidencia_id: int): Evidencia
    }
  }

  package "form" {
    class EvidenciaForm {
      - enlace: URLField
      - archivo: FileField
      - fecha: DateField
      - comentario: String
      - miembro_proyecto: MiembroProyecto
      + clean(): Map
      + is_valid(): boolean
    }
  }

  package "model" {
    class TecnicaQA {
      - id: int
      - nombre: String
      - dimension: Dimension
      - tipo_control: TipoControl
      + obtener_pasos(): List<Paso>
    }

    class Paso {
      - id: int
      - orden: int
      - instruccion: String
      - evidencia_esperada: String
    }

    class SeguimientoTecnica {
      - id: int
      - porcentaje_avance: Float
      - activa: boolean
      + calcular_avance(): Float
      + tiene_evidencias_registradas(): boolean
      + desactivar(): void
    }

    class SeguimientoPaso {
      - id: int
      - completado: boolean
      - comentario: String
      - fecha_completado: DateTime
      + esta_completado(): boolean
      + tiene_evidencia(): boolean
      + marcar_completado(comentario: String): void
    }

    class Evidencia {
      - id: int
      - enlace: String
      - archivo: String
      - fecha: Date
      - fecha_registro: DateTime
      + tiene_enlace_o_archivo(): boolean
      + nombre_archivo(): String
      + descripcion(): String
      + abrir_archivo(): File
      + clean(): void
    }
  }
}

package "reportes" #FAEEDA {
  package "model" {
    class Proyecto {
      - id: int
      - nombre: String
      - fecha_inicio: Date
      - fecha_fin: Date
      + periodo(): String
    }

    class MiembroProyecto {
      - id: int
      - rol: String
      - activo: boolean
      + clean(): void
    }
  }
}

TecnicaQA "1" -- "1..*" Paso : define
TecnicaQA "1" -- "0..*" SeguimientoTecnica : aplica
SeguimientoTecnica "1" -- "1..*" SeguimientoPaso : desglosa
SeguimientoPaso "*" -- "1" Paso : ejecuta
SeguimientoPaso "1" -- "0..1" Evidencia : se respalda con
SeguimientoTecnica "*" -- "1" Proyecto : sigue
Evidencia "*" -- "1" MiembroProyecto : autor

RegistroEvidenciaTemplate ..> RegistrarEvidenciaView : dispara solicitud >
RegistrarEvidenciaView ..> EvidenciaForm : valida datos >
RegistrarEvidenciaView ..> Evidencia : registra o reemplaza >
RegistrarEvidenciaView ..> SeguimientoPaso : completa paso >
AbrirEvidenciaView ..> Evidencia : abre >

note right of Evidencia
  UNIQUE(seguimiento_paso_id): una evidencia por paso.
  CHECK(enlace no vacio OR archivo no vacio).
  El miembro_proyecto (autor) debe pertenecer al proyecto
  del paso; se valida en clean().
  fecha es la fecha declarada por el usuario (HU-10);
  fecha_registro la sella el alta automaticamente.
  Formatos: PDF, PNG, JPG, DOCX, XLSX y TXT; maximo 5 MB.
end note

note bottom of SeguimientoPaso
  Un paso no se marca completado sin evidencia.
  marcar_completado() valida que exista la Evidencia,
  guarda fecha_completado y recalcula el avance.
end note

note right of RegistrarEvidenciaView
  Valida el formulario y que el paso exista; guarda la
  evidencia (reemplaza la anterior si la hay) y recien
  entonces completa el paso.
end note
@enduml
